{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "array",
    "items": { "$ref": "#/$defs/Publication" },
    "$defs": {
        "Publication": {
            "type": "object",
            "required": ["files", "submissionTimestamp", "description", "title", "state", "uuid"],
            "properties": {
                "uuid": { "type": "string", "minLength": 36, "maxLength": 36},
                "state": { "type": "string", "enum": ["PICKED", "SCHEDULED", "DESCRIBED", "APPEARED"] },
                "title": { "type": "string" },
                "submissionTimestamp": { "type": "integer" },
                "description": { "type": "string" },
                "apparitionTimestampIfDifferentThanSubmission": { "type": "integer" },
                "scheduleProfile": { "type": "string" },
                "scheduleIsManual": { "type": "boolean" },
                "files": {
                    "type": "array",
                    "items": { "$ref": "#/$defs/File" }
                },
                "apparitions": {
                    "type": "array",
                    "items": { "$ref": "#/$defs/Apparition" }
                },
                "freeVersionPublicationUuid": { "type": "string", "minLength": 36, "maxLength": 36}
            }
        },
        "File": {
            "type": "object",
            "required": [],
            "properties": {
                "basename": { "type": "string", "minLength": 1 },
                "sha512sum": {
                    "type": "string",
                    "minLength": 128,
                    "maxLength": 128
                },
                "fileSha512sum": {
                    "type": "string",
                    "minLength": 128,
                    "maxLength": 128
                }
            }
        },
        "Apparition": {
            "type": "object",
            "required": ["platformName", "state"],
            "properties": {
                "platformName": { "type": "string" },
                "state": { "type": "string", "enum": ["unpublished", "published_or_scheduled"] },
                "url": { "type": "string", "format": "uri", "pattern": "^[hH][tT][tT][pP][sS]?://" },
                "urlElsePublicationName": false,
                "apparitionTimestampIfDifferentThanSubmission": false,
                "priceIfNotFree": { "type": "number", "minimum": 0 },
                "tier": false,
                "tiers": { "type": "array", "items": { "type": "string" } },
                "galleries": { "type": "array", "items": { "type": "string" } }
            },
            "if": { "properties": { "platformName": { "const": "deviantart" } } },
            "else": { "properties": { "tiers": false, "galleries": false } }
        }
    }
}
